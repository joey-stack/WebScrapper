# Environment Variables & API Credentials Example
# Copy this file to .env and fill in your actual values

# Email Dispatcher & SMTP Credentials
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
IMAP_SERVER=imap.gmail.com
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_16_char_app_password
SENDER_NAME=Joel Adawah

# Multi-Account Rotation (Optional, format: email1:pass1|email2:pass2)
SENDER_ACCOUNTS=

# AI Appointment Setter & Multi-Channel Outreach Config
CALENDAR_BOOKING_URL=https://calendly.com/your-strategy-call
